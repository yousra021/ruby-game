<% if @success %>
  <div class="min-h-screen bg-cover bg-center" style="background-image: url('/background-images/game-mission-reussie-bg.png');">
    <div class="min-h-screen flex flex-col items-center justify-center space-y-6 text-[#dccdaa]">

      <h1 class="text-[48px] font-bold font-dead">MISSION ACCOMPLIE !</h1>
      <p class="text-xl flex items-center space-x-2">
        <span>🌟</span>
        <span>Gagné : +<%= @reward_xp %> XP</span>
      </p>

        <% if @rewards.present? %>
        <p class="text-lg mt-6">Tu as trouvé :</p>
        <% @rewards.each do |reward| %>
            <div class="bg-[#222] bg-opacity-70 p-6 rounded shadow-md flex flex-row text-center">
            <% if reward.equipment.image.attached? %>
                <%= image_tag reward.equipment.image, class: "w-24 h-24 mb-2 object-contain justify-center flex" %>
            <% end %>
            <h3 class="text-lg font-semibold mb-1"><%= reward.equipment.name %></h3>
            <p class="text-sm mb-3"><%= reward.equipment.description %></p>
                <div class="flex flex-col space-y-2 w-full">
                    <%= button_to "Équiper maintenant", equip_item_path(reward.id),
                        method: :post,
                        class: "bg-[#dccdaa] text-[#222] py-2 px-4 rounded shadow text-sm" %>
                    <%= button_to "Envoyer à l’inventaire",
                        character_inventory_items_path(current_character, item_id: reward.id),
                        method: :post,
                        class: "bg-[#dccdaa] text-[#222] py-2 px-4 rounded shadow text-sm" %>
                </div>
            </div>
        <% end %>
        <% else %>
        <p class="text-lg mt-6">Tu n’as trouvé aucune récompense.</p>
        <% end %>

      <%= link_to "🏕️ Retour au camp", dashboard_path,
          class: "mt-8 bg-[#222] text-[#dccdaa] px-6 py-3 rounded shadow" %>
    </div>
  </div>

<% else %>
  <div class="min-h-screen bg-cover bg-center" style="background-image: url('/background-images/game-echec-mission-bg.png');">
    <div class="min-h-screen flex flex-col items-center justify-center space-y-6 text-[#dccdaa]">

      <h1 class="text-[48px] font-bold font-dead">TU AS ÉCHOUÉ</h1>
      <p class="text-lg">Tu n’as pas réussi à compléter la mission "<strong><%= @quest.title %></strong>".</p>
      <p class="text-sm text-red-300">Aucune récompense cette fois… mais tu as appris quelque chose !</p>

      <%= link_to "🏕️ Retour au camp", dashboard_path,
          class: "bg-[#222] text-[#dccdaa] px-6 py-3 rounded shadow" %>
    </div>
  </div>
<% end %>

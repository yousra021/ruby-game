<div class="min-h-screen bg-cover bg-center" style="background-image: url('/background-images/game-home-bg.png');">
  <div class="min-h-screen flex flex-col items-center justify-center space-y-6">
    <h1 class="font-dead text-[64px] text-[#dccdaa]">Connexion</h1>

    <div class="p-6 w-80 sm:w-96">
      <%= form_with url: sessions_path, local: true do |f| %>
        <div class="mb-4">
          <%= f.label :email, "Adresse email", class: "block text-[#dccdaa] mb-1" %>
          <%= f.text_field :email, class: "w-full px-3 py-2 rounded bg-transparent border border-[#dccdaa] text-[#dccdaa] placeholder-[#aaa]" %>
        </div>

        <div class="mb-4">
          <%= f.label :password, "Mot de passe", class: "block text-[#dccdaa] mb-1" %>
          <%= f.password_field :password, class: "w-full px-3 py-2 rounded bg-transparent border border-[#dccdaa] text-[#dccdaa] placeholder-[#aaa]" %>
        </div>

        <div class="flex justify-center">
          <%= f.submit "Se connecter", class: "w-full bg-[#222] text-[#dccdaa] px-6 py-3 rounded shadow hover:bg-[#dccdaa] hover:text-[#222] hover:cursor-pointer" %>
        </div>
      <% end %>


      <div class="mt-4 text-center">
        <%= link_to "Créer un compte", new_user_path, class: "text-[#dccdaa] hover:underline" %>
      </div>
    </div>
  </div>
</div>

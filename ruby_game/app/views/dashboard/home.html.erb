<div class="min-h-screen bg-cover bg-center relative z-0 pointer-events-none" style="background-image: url('/background-images/game-home-bg.png');">
  <!-- Empêche les éléments de bloquer les clics sur l’engrenage -->
  <div class="min-h-screen pointer-events-none flex items-center justify-center">
    <!-- Autorise les clics ici uniquement -->
    <div class="flex flex-col items-center justify-center space-y-4 pointer-events-auto">
      <h1 class="font-dead text-[64px] text-[#dccdaa]">SURVIVANTS</h1>

      <% unless current_user&.gamemaster? %>
        <%= link_to "Choisir un personnage", select_characters_path,
            class: "w-60 text-center bg-[#222] text-[#dccdaa] px-6 py-3 rounded shadow" %>

        <%= link_to "Créer un personnage", new_character_path,
            class: "w-60 text-center bg-[#222] text-[#dccdaa] px-6 py-3 rounded shadow" %>
      <% end %>

      <% if current_user&.gamemaster? %>
        <%= link_to "Interface Maître du Jeu", gamemaster_dashboard_path,
            class: "w-60 text-center bg-[#222] text-[#dccdaa] px-6 py-3 rounded shadow" %>
      <% end %>

      <% if current_user %>
        <%= form_with url: logout_path, method: :delete, class: "w-60" do %>
          <button type="submit" class="w-full bg-[#222] text-[#dccdaa] px-6 py-3 rounded shadow hover:cursor-pointer">
            Déconnexion
          </button>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<!-- Bouton engrenage -->
<div id="settings-wrapper"
     class="fixed top-4 right-4 z-[9999] pointer-events-auto"
     style="z-index: 9999; pointer-events: auto;">
  <button id="open-settings"
          class="text-3xl text-[#dccdaa] hover:text-white cursor-pointer">
    ⚙️
  </button>
</div>

<!-- Modale des options -->
<div id="settings-modal"
     class="hidden fixed inset-0 bg-black bg-opacity-20 flex items-center justify-center z-[9999]"
     style="z-index: 9999;">
  <div class="bg-[#222] text-[#dccdaa] p-6 rounded shadow-lg w-80">
    <h2 class="text-xl mb-4">Options du jeu</h2>

    <!-- BOUTON MUTE / DEMUTE -->
    <button id="toggle-audio"
            class="w-full bg-[#444] px-4 py-2 cursor-pointer rounded mb-2">
      Couper le son
    </button>

    <button id="close-settings"
            class="w-full bg-[#333] px-4 cursor-pointer py-2 rounded">
      Fermer
    </button>
  </div>
</div>

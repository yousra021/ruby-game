#!/usr/bin/env bash
# Wrapper pour démarrer le serveur Rails

set -e

# Obtenir le répertoire racine
ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
APP_DIR="$ROOT_DIR/ruby_game"

# Changer vers ruby_game et lancer rails server
cd "$APP_DIR" || exit 1
BUNDLE_GEMFILE="$ROOT_DIR/Gemfile" exec bundle exec rails server "$@"

